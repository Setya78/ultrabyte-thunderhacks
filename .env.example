# Variable names only. Real values live only on the VPS (/opt/ultrabyte/app/.env, chmod 600).
DATABASE_URL=
APP_PORT=
LLM_ENABLED=false
# AI summary (optional). URL of the n8n production webhook and the header key it expects.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_HEADER=X-UltraByte-Key
N8N_WEBHOOK_KEY=
# Operator sign-in (D-2026-10-15-20). Two roles. Passwords live only in the VPS .env.
OPERATOR_ACCOUNTS=investigator:<password>:investigator,compliance:<password>:compliance
SECRET_KEY=<random string, signs the session cookie>
